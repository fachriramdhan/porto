{
    "version": 2,
    "outputDirectory": "public",
    "buildCommand": "composer install --no-dev --optimize-autoloader",
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        {
            "src": "/(css|js|build|img|data)/(.*)",
            "dest": "public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:1DuxFRnNMBZtbxXVXpmrZDJ3rMQYXXR3nH1nJGkq7HI=",
        "APP_URL": "https://fachriramdhan.vercel.app",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "CACHE_DRIVER": "array"
    }
}
