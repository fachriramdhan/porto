            "maxDuration": 10
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:1DuxFRnNMBZtbxXVXpmrZDJ3rMQYXXR3nH1nJGkq7HI=",
        "APP_URL": "https://fachriramdhan.vercel.app",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "array",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_DRIVER": "array",
        "APP_LOCALE": "en",
        "APP_FALLBACK_LOCALE": "en"
    }
}
